# PyPie-Lang Demo File
# This file demonstrates the basic syntax of PyPie-Lang

# Simple atom
(the Atom 'hello)

# Pair construction
(cons 'first 'second)

# Typed pair
(the (Pair Atom Atom) (cons 'a 'b))

# Nested pairs
(cons (cons 'x 'y) 'z)

# Complex nested structure
(cons (cons 'name 'Alice) (cons 'age 'thirty))

# Natural numbers
zero
(add1 zero)
(add1 (add1 (add1 zero)))
5
(the Nat 10)
